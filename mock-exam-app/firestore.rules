rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User profile documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Planetary exploration logs & favorites
    match /planet_favorites/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Leaderboard high scores (public read, validated anonymous-auth create)
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'score', 'timestamp', 'uid'])
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Z]{3}$')
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.timestamp == request.time;
    }

    // Mock exam leaderboard (mock-exam-app). Public read, validated anonymous-auth create.
    // NOTE: rules are project-wide. Keep agy-game/firestore.rules and mock-exam-app/firestore.rules identical.
    match /exam_scores/{scoreId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'scorePct', 'correct', 'total', 'durationSec', 'uid', 'timestamp'])
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Za-z0-9_-]{3,12}$')
        && request.resource.data.total == 50
        && request.resource.data.correct is int
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= request.resource.data.total
        && request.resource.data.scorePct is int
        && request.resource.data.scorePct == request.resource.data.correct * 2
        && request.resource.data.durationSec is int
        && request.resource.data.durationSec >= 60
        && request.resource.data.durationSec <= 7200
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.timestamp == request.time;
    }

    // General stats / logs
    match /logs/{logId} {
      allow read: if true;
      allow create: if request.auth != null;
    }
  }
}
